{
  "schemaVersion": 1,
  "id": "totem-remnant",
  "version": "${version}",
  "name": "TotemRemnant",
  "icon": "assets/totem-remnant/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.totem.remnant.TotemRemnant"],
    "client": ["dev.totem.remnant.client.TotemRemnantClient"],
    "totem:observer_screen_provider": [
      "dev.totem.remnant.client.screen.RemnantBackpackObserverScreenProvider"
    ]
  },
  "mixins": [
    "totem-remnant.mixins.json",
    {
      "config": "totem-remnant.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25",
    "totem-core": ">=0.7.23 <0.8.0"
  },
  "suggests": {
    "trinkets_updated": ">=4.2.0"
  }
}
